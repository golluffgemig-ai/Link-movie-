import threading
import time
import urllib.parse
import webbrowser
from flask import Flask, redirect, render_template_string, request

app = Flask(__name__)

HTML_TEMPLATE = """
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link Movie</title>
    <style>
        body { background-color: #1a0d13; color: white; font-family: Arial, sans-serif; padding: 15px; margin: 0; }
        .header { display: flex; justify-content: space-between; align-items: center; }
        .title { color: #ff4d79; font-size: 24px; font-weight: bold; }
        .btn-share { background-color: #28a745; color: white; border: none; padding: 8px 12px; border-radius: 5px; text-decoration: none; font-weight: bold; }
        input[type="text"] { width: 100%; padding: 12px; margin: 15px 0; border-radius: 5px; border: none; background: #2a141e; color: white; box-sizing: border-box; }
        .btn-grid { display: flex; gap: 10px; margin-bottom: 10px; }
        .btn { flex: 1; padding: 12px; border: none; border-radius: 5px; color: white; font-weight: bold; cursor: pointer; text-align: center; text-decoration: none; }
        .btn-google { background-color: #ff4d79; }
        .btn-yt { background-color: #dc3545; }
        .btn-dl { background-color: #b3003b; width: 100%; display: block; box-sizing: border-box; margin-bottom: 20px; }
        .section-title { color: #cccccc; font-size: 12px; font-weight: bold; margin-top: 15px; }
        .btn-ott { background-color: #2a141e; }
        .btn-paid { background-color: #0d6efd; }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">Link Movie</div>
        <a href="#" class="btn-share" onclick="alert('Link Movie App copied!')">Share App</a>
    </div>

    <form action="/action" method="POST">
        <input type="text" name="query" placeholder="Clip Link ya Movie Ka Naam Search Karein..." required>
        
        <div class="btn-grid">
            <button type="submit" name="type" value="google" class="btn btn-google">Google Search</button>
            <button type="submit" name="type" value="youtube" class="btn btn-yt">YouTube Search</button>
        </div>
        
        <button type="submit" name="type" value="download" class="btn btn-dl">Direct Movie Download</button>
    </form>

    <div class="section-title">FREE OTT & STREAMING APPS</div>
    <div class="btn-grid">
        <a href="/ott?url=https://www.google.com/search?q=FlixFox" class="btn btn-ott">FlixFox App</a>
        <a href="/ott?url=https://www.jiocinema.com" class="btn btn-ott">JioCinema / MX</a>
    </div>

    <div class="section-title">PAID / RECHARGE APPS</div>
    <div class="btn-grid">
        <a href="/ott?url=https://www.netflix.com" class="btn btn-paid">Netflix / Prime</a>
        <a href="/ott?url=https://www.hotstar.com" class="btn btn-paid">Hotstar / Zee5</a>
    </div>
</body>
