"""


def trigger_ads():
    print("Initial 1-2 Interstitial Ads Loaded")

    def mid_roll_ads():
        time.sleep(900)  # 15 min gap
        print("Mid-roll Ad Triggered")

    threading.Thread(target=mid_roll_ads, daemon=True).start()


@app.route("/")
def home():
    return render_template_string(HTML_TEMPLATE)


@app.route("/action", methods=["POST"])
def action():
    trigger_ads()
    query = urllib.parse.quote(request.form.get("query", ""))
    act_type = request.form.get("type")

    if act_type == "google":
        return redirect(
            f"https://www.google.com/search?q=watch+full+movie+{query}"
        )
    elif act_type == "youtube":
        return redirect(
            f"https://www.youtube.com/results?search_query=full+movie+{query}"
        )
    elif act_type == "download":
        return redirect(
            f"https://www.google.com/search?q=download+movie+{query}"
        )


@app.route("/ott")
def ott():
    trigger_ads()
    target_url = request.args.get("url")
    return redirect(target_url)


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
